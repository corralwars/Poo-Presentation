---
import Menu from "../components/menu.jsx";
import "../styles/global.css"

const currentPath = Astro.url.pathname;
const {title = "CorralWars"} = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" href="/img/sprites/roxxane_flint/flint_0001.png" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body class="bg-primary-800 text-accent-50 font-aldrich text-3xl relative z-0 overflow-x-hidden">

		<Menu client:load/>
		<a class={`absolute top-6 left-6 text-xl text-accent-300/40 ${currentPath == "/" || "/temas" ? "hidden" : ""}`} href="/temas"><span>regresar a selector</span></a>
		<slot />
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
		box-sizing: border-box;
		image-rendering: pixelated;
	}
</style>
